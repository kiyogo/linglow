# Secret Environment Files
.env
*.env
*.env.local

# Build outputs
[Bb]in/
[Oo]bj/
[Pp]ublish/
[Pp]ublish_single/
dist_package/
single_file/
Output_Installer/

# Binaries & Executables (100MB+ FFmpeg and single-file build outputs)
*.exe
*.dll
*.so
*.dylib
*.pdb
*.msi
Assets/ffmpeg/*.exe
VideoNarrator/Assets/ffmpeg/*.exe
!**/Assets/ffmpeg/.gitkeep
!**/VideoNarrator/Assets/ffmpeg/.gitkeep

# Visual Studio & IDE cache
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/

